{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/setup-env.js"
  ],
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/cache-manager|cache-manager|keyv|@keyv)/)"
  ]
}